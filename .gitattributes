# 統一換行符：repo 內一律 LF，避免 Windows/macOS 之間產生假 diff
* text=auto eol=lf

# 明確指定文字檔
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.prisma text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.webmanifest text eol=lf

# 二進位檔：不要碰
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.svg  text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary
*.xlsx  binary
*.db    binary
*.sqlite binary
